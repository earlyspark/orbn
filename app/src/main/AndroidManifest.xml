<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No external storage permission needed: orbn only reads/writes its own
         app-owned folder (getExternalFilesDir), which requires no permission. -->

    <!-- Foreground media playback (background audio + lock-screen controls). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Foreground library analysis (Doze-exempt batch tagging). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network access for the Oura Web API (the only external service orbn talks to). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Orbn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Catches the Oura OAuth2 redirect (com.earlyspark.orbn://oauth2redirect).
             The scheme/host here MUST match the OURA_REDIRECT_URI in local.properties and the
             redirect URI registered in the Oura developer portal. singleTask + the data filter
             route the browser redirect straight back into the app to finish the token exchange. -->
        <activity
            android:name=".oura.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.earlyspark.orbn"
                    android:host="oauth2redirect" />
            </intent-filter>
        </activity>

        <!-- projectM visualizer (M6 spike). Launched from the home screen; not exported. -->
        <activity
            android:name=".visualizer.VisualizerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbn" />

        <!-- Settings screen. Launched from the home screen's gear icon; not exported. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Orbn" />

        <!-- Media3 playback service: hosts ExoPlayer + MediaSession for background/lock-screen. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Background library analysis. Foreground (dataSync) so Doze does not defer it;
             pauses itself while the visualizer is active or the battery is critically low. -->
        <service
            android:name=".library.TaggingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
